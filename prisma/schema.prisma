generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["referentialIntegrity"]
  binaryTargets   = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  videosId          String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  videosId     String?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  phone         String?
  pricePaid     Float?
  roleId        String
  dolarValue    Float?
  bronze        Int       @db.TinyInt
  silver        Int       @db.TinyInt
  gold          Int       @db.TinyInt
  platinum      Int       @db.TinyInt
  sessions      Session[]
  Account       Account[]
  role          Role      @relation(fields: [roleId], references: [id])
}

model Videos {
  id                 String   @id @default(cuid())
  title              String
  description        String   @db.VarChar(1000)
  additionalMaterial String?
  idYoutube          String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Role {
  id   String @id @default(cuid())
  name String @unique
  User User[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Exchange {
  id              String            @id @default(cuid())
  tag             String            @unique
  name            String
  fee             Float
  image_url       String?
  convert         Boolean
  active          Boolean           @default(true)
  bronze          Boolean
  silver          Boolean
  gold            Boolean
  platinum        Boolean
  ExchangeCoinTax ExchangeCoinTax[]
}

model Coin {
  id              String            @id @default(cuid())
  name            String            @unique
  ticker          String
  image_url       String?
  active          Boolean
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  isFanToken      Boolean           @default(false)
  ExchangeCoinTax ExchangeCoinTax[]
}

model ExchangeCoinTax {
  id            String   @id @default(cuid())
  exchangeId    String
  coinId        String
  tax           Float
  confirmations Int
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  exchange      Exchange @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  coin          Coin     @relation(fields: [coinId], references: [id], onDelete: Cascade)
}

model IP {
  id     String @id @default(cuid())
  userId String @unique
  ip     String
}
